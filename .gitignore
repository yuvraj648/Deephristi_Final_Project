# Dependencies
node_modules/
**/node_modules/

# Python Virtual Environments
venv/
.venv/
env/
**/venv/
**/.venv/
**/env/

# Python Cache & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.ipynb_checkpoints/

# Build outputs & caches
dist/
build/
**/dist/
**/build/
.cache/
**/.cache/
.vite/
**/.vite/

# Temporary and upload directories
uploads/*
!uploads/.gitkeep
temp-uploads/*
!temp-uploads/.gitkeep
test-uploads/*
!test-uploads/.gitkeep
outputs/*
!outputs/.gitkeep
**/uploads/*
!**/uploads/.gitkeep
**/temp-uploads/*
!**/temp-uploads/.gitkeep
**/test-uploads/*
!**/test-uploads/.gitkeep
**/outputs/*
!**/outputs/.gitkeep

# Logs and OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
desktop.ini
